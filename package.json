{
  "name": "attendance_tracker",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11",
    "@tanstack/react-query": "^4.29.1",
    "@tanstack/react-query-devtools": "^4.29.1",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^13.0.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/jest": "^27.0.1",
    "@types/node": "^16.7.13",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "axios": "^0.27.2",
    "concurrently": "^8.0.1",
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "nanoid": "^4.0.2",
    "next-themes": "^0.4.6",
    "react": "^18.1.0",
    "react-confirm-alert": "^3.0.6",
    "react-datepicker": "^4",
    "react-dom": "^18.1.0",
    "react-hook-form": "^7.43.9",
    "react-icon": "^1.0.0",
    "react-icons": "^4.4.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.2",
    "react-toastify": "^9.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.0",
    "zustand": "^4.3.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "server": "json-server --port 3333 --watch db.json",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prepare": "husky install",
    "script": "concurrently \"yarn start\" \"yarn run server\"",
    "postinstall": "chakra typegen src/styles/theme.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@types/react-datepicker": "^4.19.0",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.29.4",
    "husky": "^8.0.1",
    "json-server": "^0.17.3",
    "lint-staged": "^12.4.1",
    "prettier": "^2.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix",
    "*.{js,jsx,ts,tsx,css,md}": "prettier --write"
  },
  "resolutions": {
    "@types/react": "^18.2.0"
  },
  "packageManager": "yarn@1.22.22",
  "jest": {
    "moduleNameMapper": {
      "^@ark-ui/react/(anatomy|factory)$": "<rootDir>/node_modules/@ark-ui/react/dist/components/$1.cjs",
      "^@ark-ui/react/(environment|locale)$": "<rootDir>/node_modules/@ark-ui/react/dist/providers/$1/index.cjs",
      "^@ark-ui/react/utils$": "<rootDir>/node_modules/@ark-ui/react/dist/utils/index.cjs",
      "^@ark-ui/react/(.+)$": "<rootDir>/node_modules/@ark-ui/react/dist/components/$1/index.cjs"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!(@zag-js|@ark-ui|@pandacss|@internationalized|proxy-compare|uqr|next-themes)[/\\\\]).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  }
}
